<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/layoutCropHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#CC000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Crop Image ✂️ "
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black" />

        <ImageButton
            android:id="@+id/btnRotateTouch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_speaker"
            android:contentDescription="Rotate" />
    </RelativeLayout>

    <!-- Touch Crop View (WhatsApp Interactive Crop) -->
    <com.sheempower.app.utils.TouchCropView
        android:id="@+id/touchCropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutCropFooter"
        android:layout_below="@+id/layoutCropHeader" />

    <!-- Bottom Action Bar (Cancel / Crop) -->
    <LinearLayout
        android:id="@+id/layoutCropFooter"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnTouchCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel "
            android:textSize="14sp"
            android:backgroundTint="#E74C3C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTouchCrop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Crop"
            android:textSize="14sp"
            android:backgroundTint="#2ECC71"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>