<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="?android:attr/windowBackground">

        <!-- ============================================================ -->
        <!-- ✅ TOOLBAR WITH SPEAKER ICON -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➕ نئی چیز شامل کریں"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Product"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <!-- ✅ Speaker Icon -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_speaker"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ✅ PRODUCT NAME -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="چیز کا نام / Product Name"
            android:textColor="#AA3366"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثال: ہاتھ کی بنی ہوئی زیور"
            android:padding="14dp"
            android:background="#FCE4EC"
            android:layout_marginBottom="12dp" />

        <!-- ============================================================ -->
        <!-- ✅ DESCRIPTION -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تفصیل / Description"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اپنی چیز کی تفصیل لکھیں"
            android:padding="14dp"
            android:background="#FCE4EC"
            android:layout_marginBottom="12dp"
            android:minLines="3" />

        <!-- ============================================================ -->
        <!-- ✅ PRICE -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="قیمت (روپے) / Price (PKR)"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثال: 2500"
            android:inputType="number"
            android:padding="14dp"
            android:background="#FCE4EC"
            android:layout_marginBottom="12dp" />

        <!-- ============================================================ -->
        <!-- ✅ IMAGE UPLOAD -->
        <!-- ============================================================ -->
        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📷 تصویر اپلوڈ کریں / Upload Image"
            android:textSize="14sp"
            android:backgroundTint="#FFE4EC"
            android:textColor="#FF4081" />

        <TextView
            android:id="@+id/tvImageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="کوئی تصویر منتخب نہیں / No image selected"
            android:textColor="#888888"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- ============================================================ -->
        <!-- ✅ SUBMIT BUTTON -->
        <!-- ============================================================ -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ شامل کریں / Add Product"
            android:textSize="14sp"
            android:backgroundTint="#FF4099"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>