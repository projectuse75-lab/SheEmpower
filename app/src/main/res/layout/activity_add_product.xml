<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="?android:attr/windowBackground">

        <!-- TOP NAV HEADER - NAVY BLUE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#192A56"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="➕ Add / Edit Product\nنئی چیز شامل / ایڈٹ کریں"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_speaker"
                    app:tint="#FFFFFF"
                    android:contentDescription="Speaker" />
            </RelativeLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ✅ CATEGORY SELECTION -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="زمرہ / Category"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_skeu_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="12dp" />

        <!-- ============================================================ -->
        <!-- ✅ PRODUCT NAME -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="چیز کا نام / Product Name"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثال: ہاتھ کی بنی ہوئی زیور"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginBottom="12dp" />

        <!-- ============================================================ -->
        <!-- ✅ DESCRIPTION -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تفصیل / Description"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اپنی چیز کی تفصیل لکھیں"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginBottom="12dp"
            android:minLines="3" />

        <!-- ============================================================ -->
        <!-- ✅ PRICE -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="قیمت (روپے) / Price (PKR)"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثال: 2500"
            android:inputType="number"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginBottom="12dp" />

        <!-- ============================================================ -->
        <!-- ✅ IMAGE UPLOAD -->
        <!-- ============================================================ -->
        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📷 تصویر اپلوڈ کریں / Upload Image"
            android:textSize="14sp"
            android:background="@drawable/bg_skeu_button_cream"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvImageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="کوئی تصویر منتخب نہیں / No image selected"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- ============================================================ -->
        <!-- ✅ SUBMIT BUTTON -->
        <!-- ============================================================ -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ شامل کریں / Add Product"
            android:textSize="14sp"
            android:background="@drawable/bg_skeu_button_primary"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>