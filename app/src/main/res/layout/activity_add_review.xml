<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#192A56"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBackAddReview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="⭐ Rate &amp; Review / جائزہ دیں"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Speaker" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Product / Seller Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeu_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvReviewTargetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvReviewTargetSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <!-- Verified Purchase Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Verified Purchase / تصدیق شدہ آرڈر"
                    android:textColor="#2ECC71"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Rating Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Select Rating / ریٹنگ منتخب کریں"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <RatingBar
                android:id="@+id/addRatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:numStars="5"
                android:rating="5"
                android:stepSize="1" />

            <!-- Comment Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Review Comment / جائزہ لکھیں (اختیاری)"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etAddReviewComment"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeu_input"
                android:gravity="top|start"
                android:hint="اپنا تجربہ بیان کریں... / Share your experience (min 10 chars)..."
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="0 / 500"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnSubmitAddReview"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⭐ Submit Review / جائزہ جمع کریں"
                android:fontFamily="sans-serif-bold"
                android:textSize="16sp"
                android:background="@drawable/bg_skeu_button_primary"
                android:textColor="#FFFFFF"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>