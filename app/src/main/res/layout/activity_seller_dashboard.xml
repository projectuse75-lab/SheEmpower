<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ✅ Toolbar with Speaker Icon (Rose Pink) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E91E8C"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Welcome & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE0EC"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ✅ Speaker Icon for TTS Voice Guidance -->
        <ImageButton
            android:id="@+id/btnSpeaker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_speaker"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Voice Guidance" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚪"
            android:backgroundTint="@android:color/transparent"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Add Product Button -->
    <Button
        android:id="@+id/btnAddProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="➕ Add New Product"
        android:backgroundTint="#E91E8C"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:layout_margin="16dp" />

    <!-- Order Count -->
    <TextView
        android:id="@+id/tvOrderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📦 Orders"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#E91E8C"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📭 No orders yet\n\nBuyers will place orders here."
        android:gravity="center"
        android:textColor="#888888"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="32dp" />

    <!-- Orders RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp" />

</LinearLayout>