<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="12dp" app:cardElevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvAdminSellerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="13sp" />
            <TextView android:id="@+id/tvAdminSellerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
        </LinearLayout>
        <Button android:id="@+id/btnAdminToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:backgroundTint="#FF4081" android:textColor="#FFFFFF" />
    </LinearLayout>
</androidx.cardview.widget.CardView>