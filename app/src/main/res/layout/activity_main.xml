<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical" >

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="#FF4081" android:orientation="vertical" android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="💗 شی ایمپاور"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnSpeaker"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_speaker"
                        android:contentDescription="Speaker" />
                </RelativeLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="SHE EMPOWER" android:textSize="11sp" android:gravity="center"
                    android:textColor="#FFE0EC" android:layout_marginTop="2dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <Button android:id="@+id/btnLogin" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:text="🔑 لاگ ان" android:textSize="13sp" android:backgroundTint="#FFFFFF" android:textColor="#FF4081" android:layout_marginEnd="8dp" />
                    <Button android:id="@+id/btnJoin" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:text="📝 رجسٹر" android:textSize="13sp" android:backgroundTint="#FFE4EC" android:textColor="#FF4081" />
                </LinearLayout>
            </LinearLayout>

            <EditText android:id="@+id/etSearch"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp"
                android:hint="🔍 تلاش کریں..." android:textSize="14sp" android:padding="14dp" android:background="@drawable/bg_rounded_pink" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:text="🛍️ زمرہ جات" android:textStyle="bold" android:textColor="#FF4081" android:textSize="16sp" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                <LinearLayout android:id="@+id/layoutCategories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:text="⭐ بہترین بیچنے والیاں" android:textStyle="bold" android:textColor="#FF4081" android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvTopSellers"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="16dp">
                <TextView android:id="@+id/tvProductsTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🛍️ اشیاء" android:gravity="center" android:padding="12dp" android:textStyle="bold" android:background="@drawable/bg_rounded_pink" />
                <TextView android:id="@+id/tvSellersTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🏪 بیچنے والیاں" android:gravity="center" android:padding="12dp" android:textStyle="bold" android:background="@drawable/bg_rounded_pink_light" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvLatestProducts"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav_bar" android:id="@+id/bottomNav" />

</LinearLayout>