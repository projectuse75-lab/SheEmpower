<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_skeu_header"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="✨ شی ایمپاور"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnSpeaker"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_speaker"
                        android:contentDescription="Speaker" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SHE EMPOWER"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="🔑 لاگ ان"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_skeu_button_cream"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnJoin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="📝 رجسٹر"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_skeu_button_primary"
                        android:textColor="#FFFFFF" />

                </LinearLayout>
            </LinearLayout>

            <!-- SEARCH & FILTERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="🔍 تلاش کریں..."
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:background="@drawable/bg_skeu_input"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="تلاش"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_skeu_button_primary" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCategoryFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Category ▾"
                        android:textSize="12sp"
                        android:textColor="@color/lavender_text"
                        android:background="@drawable/bg_skeu_button_cream"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnPriceFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Price ▾"
                        android:textSize="12sp"
                        android:textColor="@color/lavender_text"
                        android:background="@drawable/bg_skeu_button_cream"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnRatingFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Rating ▾"
                        android:textSize="12sp"
                        android:textColor="@color/lavender_text"
                        android:background="@drawable/bg_skeu_button_cream"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnClearFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Clear ✕"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_skeu_button_primary" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- CATEGORIES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="🛍️ زمرہ جات"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/layoutCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- TOP SELLERS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="⭐ بہترین بیچنے والیاں"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopSellers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp" />

            <!-- TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="16dp">

                <TextView
                    android:id="@+id/tvProductsTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛍️ اشیاء"
                    android:gravity="center"
                    android:padding="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_skeu_button_primary" />

                <TextView
                    android:id="@+id/tvSellersTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="🏪 بیچنے والیاں"
                    android:gravity="center"
                    android:padding="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_skeu_button_cream" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLatestProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/bottom_nav_bar"
        android:id="@+id/bottomNav" />

</LinearLayout>