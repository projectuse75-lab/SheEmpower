<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ============================================================ -->
    <!-- ✅ CONTENT AREA -->
    <!-- ============================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================================ -->
            <!-- ✅ TOOLBAR -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF4081"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💗 شی ایمپاور"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <!-- Speaker Icon -->
                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_speaker"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 Login"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#FF4081"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnJoin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Register"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#FF4081" />
            </LinearLayout>

            <!-- ============================================================ -->
            <!-- ✅ SEARCH BAR -->
            <!-- ============================================================ -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:hint="🔍 تلاش کریں..."
                android:padding="14dp"
                android:background="#FCE4EC" />

            <!-- ============================================================ -->
            <!-- ✅ CATEGORIES -->
            <!-- ============================================================ -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">
                <LinearLayout
                    android:id="@+id/layoutCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ============================================================ -->
            <!-- ✅ TOP SELLERS -->
            <!-- ============================================================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="⭐ بہترین بیچنے والیاں"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FF4081" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopSellers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp" />

            <!-- ============================================================ -->
            <!-- ✅ TABS -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="16dp">

                <TextView
                    android:id="@+id/tvProductsTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛍️ اشیاء"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textStyle="bold"
                    android:background="#FFE4EC" />

                <TextView
                    android:id="@+id/tvSellersTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏪 بیچنے والیاں"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textStyle="bold"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <!-- ============================================================ -->
            <!-- ✅ PRODUCTS / SELLERS LIST -->
            <!-- ============================================================ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLatestProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ============================================================ -->
    <!-- ✅ BOTTOM NAVIGATION -->
    <!-- ============================================================ -->
    <include
        layout="@layout/bottom_nav_bar"
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>