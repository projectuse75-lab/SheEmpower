<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ Create Buyer Profile"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create your buyer account to switch between Seller and Buyer without logging out."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etBuyerName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etBuyerEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone / WhatsApp"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etBuyerPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter phone or WhatsApp number"
            android:inputType="phone"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnCreateBuyerProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CREATE BUYER PROFILE"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_skeu_button_primary" />

        <Button
            android:id="@+id/btnCancelBuyerProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CANCEL"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_skeu_button_cream"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>