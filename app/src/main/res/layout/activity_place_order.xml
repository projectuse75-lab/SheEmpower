<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TOP HEADER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skeu_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="🛒 Place New Order\nنیا آرڈر دیں"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/text_primary"
                    android:contentDescription="Speaker" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvCategoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerOrderCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeu_card"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-bold"
            android:textSize="14sp"
            android:padding="10dp"
            android:background="@drawable/bg_skeu_card"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_skeu_card"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSellerMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSellerVerified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/success_green"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeliveryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skeu_card"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />



        <!-- Bulk / Large Order Note Banner -->
        <LinearLayout
            android:id="@+id/cardBulkOrderNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_skeu_card"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 بڑا یا خاص آرڈر بنوانا ہے؟"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/warning_amber"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اگر آپ بہت بڑا آرڈر (جیسے فنکشن کا کھانا یا بلک آرڈر) دینا چاہتی ہیں تو ڈائریکٹ واٹس ایپ پر بات کر لیں۔"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnBulkWhatsApp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="💬 واٹس ایپ پر بات کریں"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_skeu_button_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skeu_card"
            android:padding="14dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-bold" />

        <!-- Checklist -->
        <TextView
            android:id="@+id/tvChecklistHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️ اشیاء منتخب کریں / Select Items"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvChecklistEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اس بیچنے والی کی کوئی چیز موجود نہیں"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layoutProductChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_skeu_card"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <!-- Product Form Selection Tabs (Product-by-Product Form Filling) -->
        <TextView
            android:id="@+id/tvProductFormTabHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Select Product to Fill Form / فارم کے لیے چیز منتخب کریں"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutProductFormTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutDynamicFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 Total Price / کل رقم (PKR)"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:inputType="number"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvAmountLockedNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/warning_amber"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutBuyerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 آپ کا ڈیلیوری پتہ"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:padding="14dp"
                android:background="@drawable/bg_skeu_input"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 اضافی نوٹس (اختیاری)"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp" />

        <!-- SINGLE WELL-ALIGNED HORIZONTAL ROW FOR NAVIGATION BUTTONS RIGHT ABOVE PLACE ORDER -->
        <LinearLayout
            android:id="@+id/layoutWizardNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnOnlyThisOrder"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🛑 دیگر چیزیں نہیں چاہیے\nNo Other Items"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_skeu_button_primary" />

            <Button
                android:id="@+id/btnBrowseMore"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="▶️ اگلا صفحہ (دیگر فارم)\nNext Page"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_skeu_button_primary" />
        </LinearLayout>

        <!-- PAYMENT METHOD SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💵 Payment Method / ادائیگی کا طریقہ"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-bold"
            android:textSize="15sp"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/rgPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_skeu_card"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbPaymentCOD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="💵 Cash on Delivery (COD) / کیش آن ڈیلیوری"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbPaymentEasyPaisa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💳 EasyPaisa / ایزی پیسہ"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <RadioButton
                android:id="@+id/rbPaymentJazzCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💳 JazzCash / جاز کیش"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </RadioGroup>

        <!-- SELLER ACCOUNT & PAYMENT PROOF SECTION -->
        <LinearLayout
            android:id="@+id/layoutPaymentProofSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_skeu_card"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSellerAccountInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💳 Seller Account Information"
                android:textColor="@color/accent"
                android:fontFamily="sans-serif-bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ادائیگی کے بعد اپنی رسید کا اسکرین شاٹ اپلوڈ کریں / After payment, upload your payment screenshot:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnPickPaymentProof"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="📷 Upload Screenshot / رسید لائیں"
                    android:textSize="12sp"
                    android:background="@drawable/bg_skeu_button_cream"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:id="@+id/ivPaymentProofPreview"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_skeu_input"
                    android:visibility="gone"
                    android:contentDescription="Payment Proof Preview" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPaymentProofStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSubmitOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ آرڈر جمع کروائیں"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:background="@drawable/bg_skeu_button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>