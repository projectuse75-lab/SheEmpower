<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_cream"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒 نیا آرڈر دیں"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/lavender_text"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvCategoryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lavender_primary"
            android:fontFamily="sans-serif-bold"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_skeu_card"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSellerMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSellerVerified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/success_green"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeliveryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skeu_card"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSelectedItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skeu_card"
            android:padding="14dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/lavender_text"
            android:fontFamily="sans-serif-bold" />

        <!-- Checklist -->
        <TextView
            android:id="@+id/tvChecklistHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️ اشیاء منتخب کریں / Select Items"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/lavender_text"
            android:textSize="15sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvChecklistEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اس بیچنے والی کی کوئی چیز موجود نہیں"
            android:textColor="@color/text_gray"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layoutProductChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_skeu_card"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layoutDynamicFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 کل رقم (روپے)"
            android:textColor="@color/lavender_text"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:inputType="number"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvAmountLockedNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/warning_amber"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutBuyerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 آپ کا ڈیلیوری پتہ"
                android:textColor="@color/lavender_text"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:padding="14dp"
                android:background="@drawable/bg_skeu_input"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 اضافی نوٹس (اختیاری)"
            android:textColor="@color/lavender_text"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:padding="14dp"
            android:background="@drawable/bg_skeu_input"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnSubmitOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ آرڈر جمع کروائیں"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:background="@drawable/bg_skeu_button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>