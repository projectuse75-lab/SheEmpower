<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="?android:attr/windowBackground"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🛒 نیا آرڈر دیں" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF4081" android:layout_marginBottom="10dp" />

        <TextView android:id="@+id/tvCategoryHeader"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF4081" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/bg_rounded_pink"
            android:padding="14dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvSellerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:id="@+id/tvSellerMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#777777" />
            </LinearLayout>
            <TextView android:id="@+id/tvSellerVerified" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#4CAF50" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tvDeliveryInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_pink_light" android:padding="12dp"
            android:layout_marginTop="10dp" android:textSize="13sp" />

        <TextView android:id="@+id/tvSelectedItem"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_pink_light" android:padding="14dp"
            android:layout_marginTop="10dp" android:textStyle="bold" />

        <!-- Seller Profile se order karte waqt yeh checklist dikhti hai -->
        <TextView android:id="@+id/tvChecklistHeader"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🛍️ اشیاء منتخب کریں / Select Items" android:textStyle="bold" android:textColor="#FF4081"
            android:textSize="15sp" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/tvChecklistEmpty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="اس بیچنے والی کی کوئی چیز موجود نہیں" android:textColor="#888888" android:visibility="gone" android:layout_marginTop="8dp" />
        <LinearLayout android:id="@+id/layoutProductChecklist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_rounded_pink_light"
            android:padding="12dp" android:layout_marginTop="8dp" />

        <LinearLayout android:id="@+id/layoutDynamicFields"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💰 کل رقم (روپے)" android:textColor="#AA3366" android:layout_marginTop="16dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAmount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="number" android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/tvAmountLockedNote"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF6F00" android:textSize="11sp" android:layout_marginTop="4dp" android:visibility="gone" />

        <LinearLayout android:id="@+id/layoutBuyerAddress"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📍 آپ کا ڈیلیوری پتہ" android:textColor="#AA3366" android:layout_marginTop="16dp" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAddress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📝 اضافی نوٹس (اختیاری)" android:textColor="#AA3366" android:layout_marginTop="16dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNotes"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <Button android:id="@+id/btnSubmitOrder"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="✅ آرڈر جمع کروائیں" android:backgroundTint="#FF4081" android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>