<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ✅ Toolbar with App Name + Speaker Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E91E8C"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛒 Place New Order"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <!-- ✅ Speaker Icon for TTS Voice Guidance -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_speaker"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Voice Guidance" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Seller Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FCE4EC"
                android:padding="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvSellerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#333333" />
                    <TextView
                        android:id="@+id/tvSellerMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#777777"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSellerVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:text="✓ Verified" />
            </LinearLayout>

            <!-- Selected Product -->
            <TextView
                android:id="@+id/tvSelectedItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FCE4EC"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <!-- Product/Service Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Product / Service Details"
                android:textStyle="bold"
                android:textColor="#E91E8C"
                android:layout_marginTop="16dp" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe what you need in detail..."
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Amount (PKR)"
                android:textStyle="bold"
                android:textColor="#E91E8C"
                android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="3500"
                android:inputType="number"
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- Delivery Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Delivery Address"
                android:textStyle="bold"
                android:textColor="#E91E8C"
                android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your complete address..."
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- Delivery Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Preferred Delivery Date"
                android:textStyle="bold"
                android:textColor="#E91E8C"
                android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeliveryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 25/07/2024"
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- Additional Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Additional Notes (optional)"
                android:textStyle="bold"
                android:textColor="#E91E8C"
                android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Any special instructions..."
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- ✅ Receipt Upload (NEW) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳 Payment Receipt"
                android:textStyle="bold"
                android:textColor="#E91E8C"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnUploadReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Upload Receipt Image"
                android:backgroundTint="#E91E8C"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />

            <ImageView
                android:id="@+id/ivReceiptPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <!-- Submit Order Button -->
            <Button
                android:id="@+id/btnSubmitOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Submit Order"
                android:backgroundTint="#E91E8C"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>