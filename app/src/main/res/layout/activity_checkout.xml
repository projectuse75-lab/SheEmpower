<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#192A56"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBackCheckout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="💳 Checkout / آرڈر حتمی کریں"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Speaker" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Order Summary Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛍️ Order Summary / آرڈر کی تفصیلات"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/layoutCheckoutSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeu_card"
                android:padding="14dp"
                android:layout_marginTop="8dp" />

            <!-- Address Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Delivery Address / ڈیلیوری کا پتہ"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etCheckoutAddress"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeu_input"
                android:hint="مکمل پتہ درج کریں / Enter complete delivery address..."
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Payment Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 Payment Method / ادائیگی کا طریقہ"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <RadioGroup
                android:id="@+id/rgPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeu_card"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/rbCOD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="💵 Cash on Delivery (COD) / کیش آن ڈیلیوری"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Total Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_skeu_card"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grand Total / کل رقم:"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCheckoutGrandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:fontFamily="sans-serif-black"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Terms & Conditions Checkbox -->
            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="میں تمام شرائط و ضوابط تسلیم کرتی ہوں / I agree to terms &amp; conditions"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Place Order Button -->
            <Button
                android:id="@+id/btnPlaceCheckoutOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✅ Place Order / آرڈر جمع کرائیں"
                android:fontFamily="sans-serif-bold"
                android:textSize="16sp"
                android:background="@drawable/bg_skeu_button_primary"
                android:textColor="#FFFFFF"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>