<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="24dp"
                android:background="@color/bg_cream">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:background="@drawable/bg_skeu_header">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvBusinessHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨 Seller Profile"
                            android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-black"
                            android:textSize="21sp"
                            android:letterSpacing="0.02"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvOwnerHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Seller"
                            android:textColor="@color/lavender_soft"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnSpeaker"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Voice Guide"
                        android:src="@drawable/ic_speaker"
                        app:tint="#FFFFFF" />

                </RelativeLayout>

                <!-- Profile Picture + Verified Badge -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="-30dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfilePic"
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:layout_gravity="center"
                        android:src="@drawable/placeholder_avatar"
                        app:civ_border_width="4dp"
                        app:civ_border_color="#FFFFFF"/>

                    <ImageView
                        android:id="@+id/ivVerifiedBadge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_verified_badge"
                        android:visibility="gone"
                        android:contentDescription="Verified" />

                    <ImageButton
                        android:id="@+id/btnChangePic"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_circle_white"
                        android:src="@android:drawable/ic_menu_camera"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        app:tint="@color/lavender_primary"
                        android:contentDescription="Change profile picture"/>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Seller Name"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif-black"
                    android:textSize="22sp"/>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="email@gmail.com"
                    android:textColor="@color/text_gray"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvVerificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="⏳ Verification Pending"
                    android:textColor="@color/success_green"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    android:background="@drawable/bg_skeu_button_cream"/>

            </LinearLayout>

            <!-- GUEST STATE -->
            <LinearLayout
                android:id="@+id/layoutGuestState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="آپ نے ابھی لاگ ان نہیں کیا\nYou are not logged in"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif-black"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اپنی پروفائل دیکھنے کے لیے لاگ ان کریں یا نیا اکاؤنٹ بنائیں"
                    android:textColor="@color/text_gray"
                    android:fontFamily="sans-serif"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnGuestLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="🔑 لاگ ان کریں / Login"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_skeu_button_primary" />

                <Button
                    android:id="@+id/btnGuestRegister"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="📝 نیا اکاؤنٹ / Register"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_skeu_button_cream" />

            </LinearLayout>

            <!-- ROLE SWITCH -->
            <TextView
                android:id="@+id/btnSwitchRole"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="👤  SELLER  ▼"
                android:textColor="@color/lavender_text"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:background="@drawable/bg_skeu_button_cream"/>

            <!-- VIEW MODE -->
            <LinearLayout
                android:id="@+id/layoutProfileView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤  Personal Information"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvPersonalName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Full Name"/>

                <TextView
                    android:id="@+id/tvPersonalEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Email"/>

                <TextView
                    android:id="@+id/tvWhatsApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="WhatsApp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="🏪  Business Information"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Shop Name"/>

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Category"/>

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Bio / Description"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="📍  Location &amp; Delivery"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="City"/>

                <TextView
                    android:id="@+id/tvShopAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Shop Address"/>

                <TextView
                    android:id="@+id/tvDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Can Deliver"/>

                <TextView
                    android:id="@+id/tvCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Capacity"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="🛡️  Verification &amp; Rating"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvCnicStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="CNIC Verification"/>

                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Voice Verification"/>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Rating"/>

                <TextView
                    android:id="@+id/tvRatingCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Rating Count"/>

                <TextView
                    android:id="@+id/tvTopRated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:text="Top Rated"/>

            </LinearLayout>

            <!-- EDIT MODE -->
            <LinearLayout
                android:id="@+id/layoutEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✏️  Edit Profile"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-black"
                    android:textSize="20sp"
                    android:paddingBottom="16dp"/>

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Full Name"
                    android:padding="14dp"
                    android:background="@drawable/bg_skeu_input"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:hint="WhatsApp / Phone"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:background="@drawable/bg_skeu_input"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"/>

                <LinearLayout
                    android:id="@+id/layoutSellerEditFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etBusinessName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:hint="Business / Shop Name"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etBio"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="12dp"
                        android:hint="Bio / Description"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:hint="City"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"/>

                    <Spinner
                        android:id="@+id/spinnerCategoryProfile"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"/>

                    <EditText
                        android:id="@+id/etWhatsApp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:hint="WhatsApp Number"
                        android:inputType="phone"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginTop="12dp"
                        android:hint="Capacity / Daily Work"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginTop="12dp"
                        android:hint="Shop Address"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"/>

                    <Spinner
                        android:id="@+id/spinnerCanDeliverProfile"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:text="💾  SAVE CHANGES"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:background="@drawable/bg_skeu_button_primary"/>

                <Button
                    android:id="@+id/btnCancelEdit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="CANCEL"
                    android:textColor="@color/lavender_text"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_skeu_button_cream"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- MAIN BUTTONS -->
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_marginTop="8dp"
                android:text="✏️  EDIT PROFILE"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:background="@drawable/bg_skeu_button_primary"/>

            <Button
                android:id="@+id/btnMyOrders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/lavender_text"
                android:background="@drawable/bg_skeu_button_cream"
                android:text="📦  MY ORDERS"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_skeu_button_red"
                android:text="🚪  LOGOUT"/>

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav_bar"/>

</LinearLayout>