<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/ivProfilePic"
                android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/placeholder_avatar" />
            <ImageButton android:id="@+id/btnChangePic"
                android:layout_width="30dp" android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_rounded_pink"
                android:src="@android:drawable/ic_menu_camera"
                android:padding="4dp"
                android:contentDescription="Change photo" />
        </FrameLayout>

        <TextView android:id="@+id/tvName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="10dp" />

        <TextView android:id="@+id/tvEmail"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#888888" />

        <TextView android:id="@+id/tvRoleBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_pink" android:padding="8dp"
            android:layout_marginTop="8dp" android:textColor="#FF4081" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="اپنا نام" android:textColor="#AA3366" android:layout_marginTop="24dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFullName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="فون / واٹس ایپ" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPhone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:text="💾 محفوظ کریں" android:backgroundTint="#FF4081" android:textColor="#FFFFFF" android:layout_marginTop="20dp" />

        <Button android:id="@+id/btnMyOrders"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:text="📦 میرے آرڈرز" android:backgroundTint="#FFE4EC" android:textColor="#FF4081" android:layout_marginTop="10dp" />

        <Button android:id="@+id/btnLogout"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:text="🚪 لاگ آؤٹ" android:backgroundTint="#F44336" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" />

        <include layout="@layout/bottom_nav_bar" android:id="@+id/bottomNav" />

    </LinearLayout>
</ScrollView>