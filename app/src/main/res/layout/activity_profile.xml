<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤 پروفائل"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_speaker"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- Profile Photo -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/placeholder_avatar" />

            <Button
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 تصویر بدلیں"
                android:textSize="12sp"
                android:backgroundTint="#FFE4EC"
                android:textColor="#FF4081"
                android:layout_marginTop="6dp" />

            <!-- User Info -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FCE4EC"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:textColor="#FF4081"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Form -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اپنا نام / Full Name"
                android:textColor="#AA3366"
                android:layout_marginTop="24dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اپنا نام لکھیں"
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="فون / واٹس ایپ"
                android:textColor="#AA3366"
                android:layout_marginTop="14dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0300-1234567"
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="💾 محفوظ کریں / Save Changes"
                android:textSize="14sp"
                android:backgroundTint="#FF4081"
                android:textColor="#FFFFFF"
                android:layout_marginTop="20dp" />

            <Button
                android:id="@+id/btnMyOrders"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="📦 میرے آرڈرز / My Orders"
                android:textSize="14sp"
                android:backgroundTint="#FFE4EC"
                android:textColor="#FF4081"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🚪 لاگ آؤٹ / Logout"
                android:textSize="14sp"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>