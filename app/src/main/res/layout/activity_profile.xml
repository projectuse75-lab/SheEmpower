<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- ================= HEADER ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="22dp"
                android:background="@color/background">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:background="@color/primary">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF"
                        android:contentDescription="Back" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvBusinessHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨 Seller Profile"
                            android:textColor="#FFFFFF"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvOwnerHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Seller"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnSpeaker"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Voice Guide"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        app:tint="#FFFFFF" />

                </RelativeLayout>

                <!-- Profile Picture -->

                <FrameLayout
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_marginTop="28dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfilePic"
                        android:layout_width="135dp"
                        android:layout_height="135dp"
                        android:layout_gravity="center"
                        android:src="@drawable/placeholder_avatar"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/primary"/>

                    <ImageButton
                        android:id="@+id/btnChangePic"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom|end"
                        android:background="@android:color/white"
                        android:src="@android:drawable/ic_menu_camera"
                        android:contentDescription="Change profile picture"/>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seller Name"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/ivVerifiedBadge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_verified_badge"
                        android:visibility="gone"
                        android:contentDescription="Verified Badge"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="email@gmail.com"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvVerificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="⏳ Verification Pending"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="#E8F5E9"/>

            </LinearLayout>

            <!-- ================= ROLE SWITCH ================= -->

            <TextView
                android:id="@+id/btnSwitchRole"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="👤  SELLER  ▼"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:background="@drawable/bg_skeu_card"/>

            <!-- ================= VIEW MODE ================= -->

            <LinearLayout
                android:id="@+id/layoutProfileView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Personal Information -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤  Personal Information"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/gray_light"/>

                <TextView
                    android:id="@+id/tvPersonalName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Full Name"/>

                <TextView
                    android:id="@+id/tvPersonalEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Email"/>

                <TextView
                    android:id="@+id/tvWhatsApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="WhatsApp"/>


                <!-- Business Information -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="🏪  Business Information"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/gray_light"/>

                <TextView
                    android:id="@+id/tvBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Shop Name"/>

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Category"/>

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Bio / Description"/>


                <!-- Location & Delivery -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="📍  Location &amp; Delivery"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/gray_light"/>

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="City"/>

                <TextView
                    android:id="@+id/tvShopAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Shop Address"/>

                <TextView
                    android:id="@+id/tvDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Can Deliver"/>

                <TextView
                    android:id="@+id/tvCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Capacity"/>


                <!-- Verification & Rating -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="🛡️  Verification &amp; Rating"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/gray_light"/>

                <TextView
                    android:id="@+id/tvCnicStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="CNIC Verification"/>

                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Voice Verification"/>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Rating"/>

                <TextView
                    android:id="@+id/tvRatingCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Rating Count"/>

                <TextView
                    android:id="@+id/tvTopRated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:text="Top Rated"/>

            </LinearLayout>


            <!-- ================= EDIT MODE ================= -->

            <LinearLayout
                android:id="@+id/layoutEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✏️  پروفائل تبدیل کریں / Edit Profile"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:paddingBottom="16dp"/>

                <!-- Full Name Label & Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 اپنا مکمل نام / Full Name"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="نام درج کریں / Enter Full Name"
                    android:padding="14dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Phone Label & Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📞 فون نمبر / Phone Number"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="فون نمبر درج کریں / Enter Phone Number"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:background="@drawable/bg_skeu_input"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>


                <!-- Seller Fields -->

                <LinearLayout
                    android:id="@+id/layoutSellerEditFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Business Name Label & Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏪 دکان یا کاروبار کا نام / Business or Shop Name"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etBusinessName"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:hint="کاروبار کا نام / Business Name"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Bio Label & Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📝 اپنے کام کی تفصیل / Bio or Description"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etBio"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="کام کی تفصیل لکھیں / Bio &amp; Description"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- City Label & Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 شہر / City"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:hint="شہر کا نام / City Name"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Categories Label & Selection -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎨 زمرے / Categories"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCategoryProfile"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_skeu_input"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:text="زمرے منتخب کریں / Select Categories"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <!-- WhatsApp Label & Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💬 واٹس ایپ نمبر / WhatsApp Number"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etWhatsApp"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:hint="واٹس ایپ نمبر / WhatsApp Number"
                        android:inputType="phone"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Capacity Label & Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💼 روزانہ کام کی گنجائش / Capacity or Daily Work"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="گنجائش لکھیں / Daily Capacity"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Shop Address Label & Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏠 گھر یا دکان کا پتہ / Shop or Home Address"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="مکمل پتہ لکھیں / Full Address"
                        android:gravity="top"
                        android:padding="14dp"
                        android:background="@drawable/bg_skeu_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Can Deliver Label & Spinner -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚚 کیا آپ ڈیلیوری کر سکتی ہیں؟ / Can You Deliver?"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerCanDeliverProfile"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_skeu_input"
                        android:layout_marginBottom="12dp"/>

                </LinearLayout>


                <!-- Save -->

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="25dp"
                    android:text="💾  SAVE CHANGES"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"/>

                <Button
                    android:id="@+id/btnCancelEdit"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="CANCEL"
                    android:textSize="16sp"/>

            </LinearLayout>


            <!-- ================= MAIN BUTTONS ================= -->

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginTop="10dp"
                android:text="✏️  EDIT PROFILE"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"/>

            <Button
                android:id="@+id/btnMyOrders"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginTop="10dp"
                android:text="📦  MY ORDERS"/>

            <Button
                android:id="@+id/btnMyReviews"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginTop="8dp"
                android:text="⭐  MY REVIEWS / میری ریویوز"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-bold"
                android:backgroundTint="@color/primary"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginTop="5dp"
                android:text="🚪  LOGOUT"/>

            <!-- ================= GUEST STATE LAYOUT ================= -->
            <LinearLayout
                android:id="@+id/layoutGuestState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnGuestLogin"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:text="🔑 Login"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/primary"/>

                <Button
                    android:id="@+id/btnGuestRegister"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
