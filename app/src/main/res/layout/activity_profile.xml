<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ✅ TOOLBAR with App Name + Speaker Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E91E8C"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 Profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <!-- ✅ Speaker Icon for TTS Voice Guidance -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_speaker"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Voice Guidance" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Profile Photo -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/placeholder_avatar" />

            <!-- Change Photo Button -->
            <Button
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Change Photo"
                android:backgroundTint="#E91E8C"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="10dp" />

            <!-- Email -->
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="14sp" />

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tvRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FCE4EC"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:textColor="#E91E8C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Full Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#E91E8C"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- Phone / WhatsApp -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone / WhatsApp"
                android:textColor="#E91E8C"
                android:textStyle="bold"
                android:layout_marginTop="14dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0300-1234567"
                android:padding="14dp"
                android:background="#FCE4EC"
                android:layout_marginTop="6dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Save Changes"
                android:backgroundTint="#E91E8C"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginTop="20dp" />

            <!-- My Orders Button -->
            <Button
                android:id="@+id/btnMyOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 My Orders"
                android:backgroundTint="#FCE4EC"
                android:textColor="#E91E8C"
                android:padding="14dp"
                android:layout_marginTop="10dp" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚪 Logout"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>