<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivSellerAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/placeholder_avatar" />

            <ImageView
                android:id="@+id/ivSellerVerifiedBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_verified_badge"
                android:visibility="gone"
                android:contentDescription="Verified" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSellerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_dark"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvSellerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/lavender_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSellerCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_gray"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvSellerRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/star_gold"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSellerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/success_green"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSellerDeliveryBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSellerBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvSellerCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:textColor="@color/lavender_text"
            android:background="@drawable/bg_skeu_input"
            android:padding="10dp"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <!-- BUYER ACTIONS -->
        <LinearLayout
            android:id="@+id/layoutBuyerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnPlaceOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🛒 آرڈر دیں"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_skeu_button_primary"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnWhatsAppChat"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💬 واٹس ایپ پر بات کریں"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_skeu_button_green"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ADMIN REVIEW PANEL -->
        <LinearLayout
            android:id="@+id/layoutAdminReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_skeu_card"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ ایڈمن — تصدیقی دستاویزات"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/lavender_text"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnViewCnic"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🖼️ شناختی کارڈ دیکھیں / View CNIC"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_skeu_button_cream"
                android:textColor="@color/lavender_text"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnPlayVoice"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🔊 آواز سنیں / Play Voice Sample"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_skeu_button_cream"
                android:textColor="@color/lavender_text"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdminApprove"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="✅ منظور کریں"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    android:background="@drawable/bg_skeu_button_green"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnAdminReject"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="❌ مسترد کریں"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    android:background="@drawable/bg_skeu_button_red"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️ اشیاء"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:textSize="16sp"
            android:textColor="@color/lavender_text"
            android:layout_marginTop="20dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSellerProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>