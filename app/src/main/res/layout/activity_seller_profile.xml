<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ✅ TOOLBAR with Speaker Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 Seller Profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E91E8C" />

            <!-- ✅ Speaker Icon for TTS Voice Guidance -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_speaker"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Voice Guidance" />
        </LinearLayout>

        <!-- Seller Avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivSellerAvatar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:src="@drawable/placeholder_avatar" />

        <!-- Seller Name -->
        <TextView
            android:id="@+id/tvSellerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp" />

        <!-- Seller Category -->
        <TextView
            android:id="@+id/tvSellerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#E91E8C"
            android:textSize="14sp" />

        <!-- Seller City -->
        <TextView
            android:id="@+id/tvSellerCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- Seller Rating -->
        <TextView
            android:id="@+id/tvSellerRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFA000"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Seller Status (Verified/Pending) -->
        <TextView
            android:id="@+id/tvSellerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#4CAF50"
            android:textStyle="bold" />

        <!-- Seller Bio -->
        <TextView
            android:id="@+id/tvSellerBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- ✅ Place Order Button (Rose Pink as per prompt) -->
        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛒 Place Order"
            android:backgroundTint="#E91E8C"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:layout_marginTop="16dp" />

        <!-- WhatsApp Chat Button -->
        <Button
            android:id="@+id/btnWhatsAppChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 Chat on WhatsApp"
            android:backgroundTint="#25D366"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:layout_marginTop="8dp" />

        <!-- Products Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️ Products"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#E91E8C"
            android:layout_marginTop="20dp" />

        <!-- Products RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSellerProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>