<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FF4081"
            android:padding="20dp"
            android:gravity="center">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="💗 شی ایمپاور"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_speaker"
                    android:contentDescription="Speaker"
                    android:scaleType="centerInside" />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHE EMPOWER"
                android:textSize="12sp"
                android:textColor="#FFE0EC"
                android:layout_marginTop="8dp" />

        </LinearLayout>


        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- LOGIN TYPE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_pink"
                android:padding="14dp"
                android:layout_marginBottom="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔑 کون ہو؟ / Who are you?"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnBuyerLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🛍️ خریدار / BUYER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF4081"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSellerLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🏪 بیچنے والی / SELLER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081"
                    android:backgroundTint="#FFFFFF" />

            </LinearLayout>


            <!-- LOGIN TITLE -->
            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="خریدار کے لیے لاگ ان / Buyer Login"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF4081"
                android:gravity="center"
                android:layout_marginBottom="22dp" />


            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📧 ای میل ایڈریس / Email Address"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#AA3366"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="apna_email@example.com"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_rounded_pink"
                android:layout_marginBottom="18dp"
                android:inputType="textEmailAddress" />


            <!-- PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 پاس ورڈ / Password"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#AA3366"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="کم از کم 8 حروف / Min 8 characters"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/bg_rounded_pink" />

                <ImageButton
                    android:id="@+id/togglePasswordVisibility"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="Show/Hide Password"
                    android:scaleType="centerInside" />

            </FrameLayout>


            <!-- PASSWORD STRENGTH -->
            <ProgressBar
                android:id="@+id/passwordStrengthBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="6dp"
                android:progressDrawable="@drawable/progress_password_strength"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="طاقت / Strength:"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/passwordStrengthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کمزور ❌"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081" />

            </LinearLayout>


            <!-- LOGIN BUTTON -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🔑 لاگ ان کریں / LOGIN"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF4081"
                android:layout_marginBottom="10dp" />


            <!-- FORGOT PASSWORD -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❓ پاس ورڈ بھول گئے؟ / Forgot Password?"
                android:textSize="12sp"
                android:textColor="#FF4081"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="4dp" />


            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFE0EC"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp" />


            <!-- REGISTRATION TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 نیا اکاؤنٹ بنائیں / Create Account"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF4081"
                android:gravity="center"
                android:layout_marginBottom="12dp" />


            <!-- BUYER REGISTRATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_pink"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛍️ خریدار / Buyer"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvGoBuyerRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نیا خریدار ہوں - اکاؤنٹ بنائیں\nNew buyer - Create account"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:padding="10dp"
                    android:background="#FFFFFF"
                    android:gravity="center" />

            </LinearLayout>


            <!-- SELLER REGISTRATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_pink"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏪 بیچنے والی / Seller"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvGoSellerRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="کام شروع کرنا چاہتی ہیں - رجسٹر کریں\nWant to sell - Register"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:padding="10dp"
                    android:background="#FFFFFF"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>