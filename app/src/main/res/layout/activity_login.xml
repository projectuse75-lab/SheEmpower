<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- ============================================================ -->
        <!-- TOOLBAR WITH SPEAKER ICON -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💗 شی ایمپاور"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FF4081" />

            <!-- Speaker Icon -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_speaker"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لاگ اِن / Login"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF4081"
            android:layout_marginBottom="20dp" />

        <!-- ============================================================ -->
        <!-- EMAIL FIELD -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ای میل ایڈریس / Email Address"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="apna_email@example.com"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="#FCE4EC"
            android:layout_marginBottom="16dp" />

        <!-- ============================================================ -->
        <!-- PASSWORD FIELD WITH SHOW/HIDE EYE ICON -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پاس ورڈ / Password"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <!-- FrameLayout for password field + eye icon -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="پاس ورڈ درج کریں"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:padding="14dp"
                android:paddingEnd="45dp"
                android:background="#FCE4EC" />

            <!-- Eye Icon Button (Right Side) -->
            <ImageButton
                android:id="@+id/togglePasswordVisibility"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_eye_closed"
                android:contentDescription="Toggle Password Visibility"
                android:scaleType="centerInside" />
        </FrameLayout>

        <!-- ============================================================ -->
        <!-- PASSWORD STRENGTH INDICATOR -->
        <!-- ============================================================ -->
        <!-- Strength Progress Bar -->
        <ProgressBar
            android:id="@+id/passwordStrengthBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="4dp"
            android:progressDrawable="@drawable/progress_password_strength"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal" />

        <!-- Strength Label -->
        <TextView
            android:id="@+id/passwordStrengthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کمزور ⌁"
            android:textSize="12sp"
            android:textColor="#FF4081"
            android:layout_marginBottom="12dp" />

        <!-- ============================================================ -->
        <!-- LOGIN BUTTON -->
        <!-- ============================================================ -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔑 لاگ اِن کریں / Login"
            android:textSize="15sp"
            android:backgroundTint="#FF4081"
            android:textColor="#FFFFFF" />

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot Password?\nپاس ورڈ بھول گئے؟"
            android:textColor="#FF4081"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:gravity="center"
            android:textAlignment="center" />

        <!-- Buyer Register -->
        <TextView
            android:id="@+id/tvGoBuyerRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New buyer? Create account\nنئے خریدار ہیں؟ اکاؤنٹ بنائیں"
            android:textColor="#FF4081"
            android:textSize="13sp"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:gravity="center"
            android:textAlignment="center" />

        <!-- Seller Register -->
        <TextView
            android:id="@+id/tvGoSellerRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Want to sell? Register\nکام شروع کرنا چاہتی ہیں؟ رجسٹر کریں"
            android:textColor="#FF4081"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:gravity="center"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>