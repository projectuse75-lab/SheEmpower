<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- LOGO & BRAND HEADER (WHITE BACKGROUND TO MATCH LOGO) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/logo_512"
                    android:contentDescription="She Empower Logo" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_speaker"
                    android:contentDescription="Speaker"
                    android:scaleType="centerInside" />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHE EMPOWER"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/primary"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="شی ایمپاور"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>


        <!-- MAIN CONTENT CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- LOGIN TITLE -->
            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 لاگ ان / Login"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginBottom="24dp" />


            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📧 ای میل ایڈریس / Email Address"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="apna_email@example.com"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_skeu_input"
                android:layout_marginBottom="18dp"
                android:inputType="textEmailAddress" />


            <!-- PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 پاس ورڈ / Password"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="کم از کم 8 حروف / Min 8 characters"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/bg_skeu_input" />

                <ImageButton
                    android:id="@+id/togglePasswordVisibility"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="Show/Hide Password"
                    android:scaleType="centerInside" />

            </FrameLayout>


            <!-- PASSWORD STRENGTH -->
            <ProgressBar
                android:id="@+id/passwordStrengthBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="6dp"
                android:progressDrawable="@drawable/progress_password_strength"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="طاقت / Strength:"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/passwordStrengthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کمزور ❌"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/primary" />

            </LinearLayout>


            <!-- LOGIN BUTTON -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔑 لاگ ان کریں / LOGIN"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_skeu_button_primary"
                android:layout_marginBottom="10dp" />


            <!-- FORGOT PASSWORD -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❓ پاس ورڈ بھول گئے؟ / Forgot Password?"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginBottom="4dp" />


            <!-- VISITOR / GUEST MODE OPTION -->
            <TextView
                android:id="@+id/tvContinueVisitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👀 بغیر اکاؤنٹ آگے بڑھیں (میہمان / Visitor Mode)"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_skeu_button_cream"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />


            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />


            <!-- REGISTRATION TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 نیا اکاؤنٹ بنائیں / Create Account"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />


            <!-- BUYER REGISTRATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeu_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛍️ خریدار / Buyer"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvGoBuyerRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نیا خریدار ہوں - اکاؤنٹ بنائیں\nNew buyer - Create account"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:background="@drawable/bg_skeu_button_cream"
                    android:gravity="center" />

            </LinearLayout>


            <!-- SELLER REGISTRATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeu_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏪 بیچنے والی / Seller"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvGoSellerRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="کام شروع کرنا چاہتی ہیں - رجسٹر کریں\nWant to sell - Register"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:background="@drawable/bg_skeu_button_cream"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>