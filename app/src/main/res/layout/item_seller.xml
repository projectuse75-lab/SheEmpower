<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_skeu_card"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivSellerAvatar"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/placeholder_avatar" />

    <TextView
        android:id="@+id/tvSellerRatingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/star_gold"
        android:fontFamily="sans-serif-bold"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvSellerBizName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvSellerCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#ED3A9C"
        android:fontFamily="sans-serif-medium"
        android:textSize="11sp" />
</LinearLayout>