<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_cream">

    <!-- Logo -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/logo_512"
        android:contentDescription="She Empower Logo" />

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="She Empower"
        android:textSize="28sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/lavender_text"
        android:layout_marginTop="16dp" />

    <!-- Quote -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💜 Empowering Women, One Sale at a Time"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_gray"
        android:layout_marginTop="6dp" />

</LinearLayout>