<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ============================================================ -->
        <!-- ✅ TOOLBAR WITH SPEAKER ICON -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁 خریدار بنیں"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FF4081" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buyer Registration"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <!-- ✅ Speaker Icon -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_speaker"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ✅ FORM FIELDS -->
        <!-- ============================================================ -->

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اپنا نام / Full Name"
            android:textColor="#AA3366"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="👤 مثال: فاطمہ بی بی"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="@drawable/bg_rounded_pink"
            android:layout_marginBottom="14dp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ای میل / Email"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📧 apna_email@example.com"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="@drawable/bg_rounded_pink"
            android:layout_marginBottom="14dp" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="پاس ورڈ / Password"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔒 کم از کم 6 حروف"
            android:inputType="textPassword"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="@drawable/bg_rounded_pink"
            android:layout_marginBottom="14dp" />

        <!-- ✅ Confirm Password (NEW - Required) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="پاس ورڈ دوبارہ لکھیں / Confirm Password"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔒 پاس ورڈ دوبارہ لکھیں"
            android:inputType="textPassword"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="@drawable/bg_rounded_pink"
            android:layout_marginBottom="14dp" />

        <!-- Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="فون / واٹس ایپ (اختیاری)"
            android:textColor="#AA3366"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📱 0300-1234567"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="@drawable/bg_rounded_pink"
            android:layout_marginBottom="20dp" />

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ اکاؤنٹ بنائیں / Create Account"
            android:textSize="14sp"
            android:backgroundTint="#FF4081"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>