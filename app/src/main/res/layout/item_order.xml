<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_skeu_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOrderProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvOrderAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-bold"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOrderParty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvOrderDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvOrderAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvOrderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_skeu_button_primary"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnAdvanceStatus"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_skeu_button_green"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

</LinearLayout>