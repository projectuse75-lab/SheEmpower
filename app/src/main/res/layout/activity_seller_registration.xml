<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏪 اپنا کام شروع کریں" android:textSize="22sp" android:textStyle="bold" android:textColor="#FF4081" />

            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Speaker" />
        </RelativeLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نام / Full Name" android:textColor="#AA3366" android:layout_marginTop="16dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSellerName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ای میل / Email" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSellerEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="پاس ورڈ / Password" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSellerPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:hint="کم از کم 6 حروف" android:padding="14dp"
            android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="کاروبار کا نام / Business Name" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBusinessName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شہر / City" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مختصر تعارف / Short Bio" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBio"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱 واٹس ایپ نمبر / WhatsApp" android:textColor="#FF4081" android:textStyle="bold" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etWhatsApp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="923001234567" android:inputType="phone" android:padding="14dp"
            android:background="@drawable/bg_rounded_green" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/tvWhatsAppHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#4CAF50" android:textSize="12sp" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛍️ زمرہ / Category" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <Spinner android:id="@+id/spinnerCategory"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🙋‍♀️ آپ کتنے لوگوں کے لیے کام کر سکتی ہیں؟" android:textColor="#AA3366" android:textStyle="bold" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCapacity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="مثال: 50 لوگوں تک کھانا بنا سکتی ہوں" android:padding="14dp"
            android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:id="@+id/tvDeliverLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#AA3366" android:textStyle="bold" android:layout_marginTop="14dp" />
        <Spinner android:id="@+id/spinnerCanDeliver"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📍 دکان / گھر کا مکمل پتہ (اگر آپ خود نہ جا سکیں تو خریدار کو یہی دکھایا جائے گا)"
            android:textColor="#AA3366" android:textStyle="bold" android:layout_marginTop="14dp" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etShopAddress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="مکمل پتہ لکھیں" android:padding="14dp"
            android:background="@drawable/bg_rounded_pink" android:layout_marginTop="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📋 شناختی کارڈ (ضروری)" android:textColor="#AA3366" android:layout_marginTop="16dp" />
        <Button android:id="@+id/btnPickCnic"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="📷 تصویر اپلوڈ کریں" android:layout_marginTop="6dp"
            android:backgroundTint="#FFE4EC" android:textColor="#FF4081" />
        <TextView android:id="@+id/tvCnicStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#888888" android:layout_marginTop="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎙️ آواز کا تعارف (اختیاری)" android:textColor="#AA3366" android:layout_marginTop="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btnRecord"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="🎙 ریکارڈ کریں" android:textSize="12sp" android:backgroundTint="#FF4081" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnPickAudio"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="📁 اپلوڈ" android:textSize="12sp"
                android:backgroundTint="#FFE4EC" android:textColor="#FF4081" />
        </LinearLayout>
        <TextView android:id="@+id/tvVoiceStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#888888" android:layout_marginTop="4dp" android:layout_marginBottom="20dp" />

        <Button android:id="@+id/btnSellerRegister"
            android:layout_width="match_parent" android:layout_height="58dp"
            android:text="🚀 رجسٹریشن جمع کروائیں" android:backgroundTint="#FF4081" android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>