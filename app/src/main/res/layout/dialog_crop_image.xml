<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#192A56"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✂️ Crop &amp; Adjust Image / تصویر کاٹیں اور سیٹ کریں"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Image Preview Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F1B3D"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivCropPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Crop Preview" />
    </FrameLayout>

    <!-- Manual Edge Crop Controls (Top, Bottom, Left, Right) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تصویر کی سائیڈز کاٹیں / Trim Edges:"
        android:textColor="#F7D794"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnCropTop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="⬆️ Crop Top"
            android:textSize="11sp"
            android:backgroundTint="#2A3F75"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCropBottom"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="⬇️ Crop Bottom"
            android:textSize="11sp"
            android:backgroundTint="#2A3F75"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCropLeft"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="⬅️ Crop Left"
            android:textSize="11sp"
            android:backgroundTint="#2A3F75"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCropRight"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="➔ Crop Right"
            android:textSize="11sp"
            android:backgroundTint="#2A3F75"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Rotate & Reset Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnRotateLeft"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="↺ Rotate Left"
            android:textSize="10sp"
            android:backgroundTint="#2A3F75"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnResetCrop"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="↺ Reset Original"
            android:textSize="10sp"
            android:backgroundTint="#E67E22"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRotateRight"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="↻ Rotate Right"
            android:textSize="10sp"
            android:backgroundTint="#2A3F75"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Action Buttons (Confirm / Cancel) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCrop"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Cancel / منسوخ کریں"
            android:textSize="12sp"
            android:backgroundTint="#E74C3C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnConfirmCrop"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="✅ Use Picture / یہ تصویر لگائیں"
            android:textSize="12sp"
            android:backgroundTint="#2ECC71"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>