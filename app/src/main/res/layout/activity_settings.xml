<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        android:background="@color/primary_pink">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️"
            android:textSize="34sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سیٹنگز"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- USER CARD -->

            <!-- USER CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/settings_user_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged in as"
                    android:textColor="@color/skeu_pink_light"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="@color/card_bg"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="@color/card_bg"
                    android:textSize="14sp"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:id="@+id/tvUserContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- ACCOUNT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤  Account"
                android:textColor="@color/primary_pink"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"/>

            <!-- CHANGE NAME -->

            <LinearLayout
                android:id="@+id/llChangeName"
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="✏️"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Change Name"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="اپنا نام تبدیل کریں"/>

                </LinearLayout>

                <TextView
                    style="@style/SettingsArrowStyle"
                    android:text="›"/>

            </LinearLayout>

            <!-- CHANGE CONTACT -->

            <LinearLayout
                android:id="@+id/llChangeContact"
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="📱"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Change Contact"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="WhatsApp / contact number"/>

                </LinearLayout>

                <TextView
                    style="@style/SettingsArrowStyle"
                    android:text="›"/>

            </LinearLayout>

            <!-- CHANGE PASSWORD -->

            <LinearLayout
                android:id="@+id/llChangePassword"
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="🔐"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Change Password"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="اپنا password محفوظ رکھیں"/>

                </LinearLayout>

                <TextView
                    style="@style/SettingsArrowStyle"
                    android:text="›"/>

            </LinearLayout>

            <!-- APP SETTINGS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️  App Settings"
                android:textColor="@color/primary_pink"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"/>

            <!-- NOTIFICATIONS -->

            <LinearLayout
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="🔔"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Notifications"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="Enable / Disable notifications"/>

                </LinearLayout>

                <Switch
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary_pink"/>

            </LinearLayout>

            <!-- DARK THEME -->

            <LinearLayout
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="🌙"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Dark Theme"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="Enable / Disable dark mode"/>

                </LinearLayout>

                <Switch
                    android:id="@+id/switchDarkTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary_pink"/>

            </LinearLayout>

            <!-- INFORMATION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️  More Information"
                android:textColor="@color/primary_pink"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"/>

            <!-- PRIVACY -->

            <LinearLayout
                android:id="@+id/llPrivacyPolicy"
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="🔒"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Privacy Policy"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="رازداری کی پالیسی"/>

                </LinearLayout>

                <TextView
                    style="@style/SettingsArrowStyle"
                    android:text="›"/>

            </LinearLayout>

            <!-- TERMS -->

            <LinearLayout
                android:id="@+id/llTermsConditions"
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="📜"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="Terms &amp; Conditions"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="شرائط و ضوابط"/>

                </LinearLayout>

                <TextView
                    style="@style/SettingsArrowStyle"
                    android:text="›"/>

            </LinearLayout>

            <!-- ABOUT -->

            <LinearLayout
                android:id="@+id/llAboutApp"
                style="@style/SettingsCardStyle"
                android:background="@drawable/settings_item_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsIconStyle"
                    android:text="💗"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitleStyle"
                        android:text="About She Empower"/>

                    <TextView
                        style="@style/SettingsSubtitleStyle"
                        android:text="Version 1.0"/>

                </LinearLayout>

                <TextView
                    style="@style/SettingsArrowStyle"
                    android:text="›"/>

            </LinearLayout>

            <!-- LOGOUT -->

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="LOGOUT"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/primary_pink"
                android:layout_marginTop="28dp"/>

            <!-- DELETE -->

            <Button
                android:id="@+id/btnDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="DELETE ACCOUNT"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/error_red"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

    </ScrollView>
    <include
        layout="@layout/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"/>

</LinearLayout>