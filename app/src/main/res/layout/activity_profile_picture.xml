<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="?android:attr/windowBackground">

    <!-- ===== TITLE ===== -->
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👤 میری تصویر شیئر کریں / Share My Profile"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- ===== IMAGE DISPLAY ===== -->
    <ImageView
        android:id="@+id/iv_profile_image"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_skeu_card"
        android:src="@drawable/ic_profile_placeholder"
        android:layout_marginBottom="24dp"
        android:contentDescription="Profile Image"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />

    <!-- ===== INFO TEXT ===== -->
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📸 تصویر کے اوپر click کریں مکمل details دیکھنے کے لیے / Click on image to see full details"
        android:textSize="12sp"
        android:textColor="@color/text_gray"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- ===== SELECT IMAGE BUTTON ===== -->
    <Button
        android:id="@+id/btn_select_image"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📸 تصویر منتخب کریں / Select Image"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:backgroundTint="#FF4081" />

</LinearLayout>
