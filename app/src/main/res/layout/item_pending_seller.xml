<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="14dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:background="?android:attr/windowBackground"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvPendingName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/tvPendingMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="12sp" />
        <TextView android:id="@+id/tvPendingWhatsApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#25D366" android:textSize="12sp" android:layout_marginTop="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/btnApprove" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="✅ Approve" android:backgroundTint="#4CAF50" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnReject" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="❌ Reject" android:backgroundTint="#F44336" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>