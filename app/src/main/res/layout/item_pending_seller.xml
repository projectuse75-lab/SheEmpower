<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_skeu_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPendingName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_dark"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvPendingMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvPendingWhatsApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/whatsapp_green"
        android:fontFamily="sans-serif-medium"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnApprove"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✅ Approve"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_skeu_button_green"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="❌ Reject"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_skeu_button_red"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>