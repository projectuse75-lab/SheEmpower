<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Business Name -->
        <TextView
            android:id="@+id/tvPendingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

        <!-- Owner · Category · City -->
        <TextView
            android:id="@+id/tvPendingMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- WhatsApp Number -->
        <TextView
            android:id="@+id/tvPendingWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#25D366"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- ============================================================ -->
        <!-- ✅ CNIC + Voice Verification Buttons -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnViewCnic"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="🪪 CNIC"
                android:textSize="11sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnPlayVoice"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="🔊 Voice"
                android:textSize="11sp"
                android:backgroundTint="#9C27B0"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ✅ Approve / Reject / Top Rated Buttons -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Approve Button -->
            <Button
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✅ Approve"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="8dp" />

            <!-- Reject Button -->
            <Button
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="❌ Reject"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:padding="8dp" />

            <!-- Top Rated Toggle Button -->
            <Button
                android:id="@+id/btnToggleTopRated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⭐ Top"
                android:backgroundTint="#FFA000"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>