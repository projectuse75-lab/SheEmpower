<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#403B0764" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Raised Button Gradient -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#8B5CF6"
                android:centerColor="@color/lavender_primary"
                android:endColor="@color/lavender_dark"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#C4B5FD" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Top Gloss Shine Highlight -->
    <item android:bottom="3dp" android:top="1dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#70FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>