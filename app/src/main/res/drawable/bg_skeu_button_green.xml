<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#40064E3B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#34D399"
                android:centerColor="#10B981"
                android:endColor="#059669"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#A7F3D0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:top="1dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#70FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>