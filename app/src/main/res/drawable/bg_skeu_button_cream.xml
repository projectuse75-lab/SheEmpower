<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#202D253B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFDF9"
                android:centerColor="#FAF5EF"
                android:endColor="#EDE9FE"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#DDD6FE" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>