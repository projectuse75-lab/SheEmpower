<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top Shadow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#202D253B"
                android:endColor="#00000000"
                android:angle="270" />
        </shape>
    </item>
    <!-- Nav Bar Cream Gradient -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFDF9"
                android:centerColor="#FAF5EF"
                android:endColor="#F0E5D8"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>